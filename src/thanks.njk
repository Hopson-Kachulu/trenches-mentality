<div class="wrap" style="padding:5rem 1rem 6rem;max-width:42rem">
  <p class="eyebrow">Received</p>
  <h1 id="thanks-title">Thank you. You're in.</h1>
  <p id="thanks-text" style="font-size:1.2rem">We got it. Keep building. While you wait, read something from the blog.</p>
  <p><a class="btn" href="/blog/">Read the stories</a></p>
</div>
<script>
  if (location.search.includes("f=contact")) {
    document.getElementById("thanks-title").textContent = "Message received.";
    document.getElementById("thanks-text").textContent = "Thanks for reaching out. A real person will read it and reply, usually within two days.";
  }
  if (location.search.includes("f=inner-circle")) {
    document.getElementById("thanks-title").textContent = "Welcome to the Inner Circle.";
    document.getElementById("thanks-text").textContent = "We're checking your payment now. Your invite and first guides will reach you on WhatsApp and email within 24 hours.";
  }
</script>
