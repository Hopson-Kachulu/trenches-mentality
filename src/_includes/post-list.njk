{%- if postsToShow.length %}
<ul class="post-list">
  {%- for post in postsToShow %}
  <li class="post-item">
    <div class="meta">
      <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
      {%- if post.data.pillar %}<br><a class="tag" href="/pillar/{{ post.data.pillar | slug }}/">{{ post.data.pillar }}</a>{% endif %}
    </div>
    <div>
      <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
      {%- if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
    </div>
  </li>
  {%- endfor %}
</ul>
{%- else %}
<p class="empty">Nothing here yet. The first stories are being written.</p>
{%- endif %}
